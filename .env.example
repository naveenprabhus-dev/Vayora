# ==============================================================================
# Urban Air Quality Assistant — Environment Configuration Template
# ==============================================================================
# SECURITY NOTICE:
# - Copy this file to `.env` for local development. Never commit `.env`.
# - Never place private keys or server secrets in `VITE_*` or `NEXT_PUBLIC_*`
#   variables, as those are bundled into client-side browser code.
# ==============================================================================

# --- Runtime Environment ------------------------------------------------------
NODE_ENV="development"
PORT="3000"
API_PORT="4000"
APP_URL="http://localhost:3000"
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# --- Server-Side Gemini AI Orchestration (NEVER expose to browser) ------------
# Required on the backend (`apps/api`) for Phase 2+ AI generation.
# In Google AI Studio, configure via Settings > Secrets.
GEMINI_API_KEY="REPLACE_WITH_SERVER_ONLY_GEMINI_API_KEY"
GEMINI_MODEL_PRIMARY="gemini-4-hydrogen"

# --- Server-Side Firebase ID Token Verification & RBAC ------------------------
# Project ID used by `firebase-admin` to verify Firebase Auth ID tokens.
FIREBASE_PROJECT_ID="REPLACE_WITH_FIREBASE_PROJECT_ID"
# Optional comma-separated verified email lists for elevated RBAC roles (server-side only).
ADMIN_EMAILS=""
COORDINATOR_EMAILS=""
# Optional: path to local service account JSON outside the git repository
# (for local non-ADC environments only; never commit credential files).
# GOOGLE_APPLICATION_CREDENTIALS="/secure/path/outside-repo/service-account.json"

# --- Live Air Quality API Adapter (Server-Side Only, Phase 2+) ----------------
AIR_QUALITY_API_PROVIDER="open-meteo"
AIR_QUALITY_API_KEY=""
AIR_QUALITY_API_TIMEOUT_MS="5000"
OPEN_METEO_AIR_QUALITY_BASE_URL="https://air-quality-api.open-meteo.com/v1/air-quality"
OPEN_METEO_GEOCODING_BASE_URL="https://geocoding-api.open-meteo.com/v1/search"
AIR_QUALITY_CACHE_TTL_MS="600000"
AIR_QUALITY_STALE_TTL_MS="21600000"
GEOCODING_CACHE_TTL_MS="86400000"

# --- Rate Limiting Configuration (apps/api) -----------------------------------
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_AUTH_MAX_REQUESTS="20"

# --- Client-Side Public Firebase Web Configuration (apps/web) -----------------
# Public Firebase client identifiers ONLY (security enforced by Firestore rules).
VITE_API_BASE_URL="/api/v1"
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_DATABASE_ID=""
