{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Non-PII account metadata and server-controlled role state for authenticated household members.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["regular_user", "community_coordinator", "admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "role", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Strictly isolated PII document containing verified account email.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 320
        },
        "termsAcceptedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "termsAcceptedAt", "createdAt", "updatedAt"]
    },
    "HouseholdProfile": {
      "title": "HouseholdProfile",
      "description": "User-owned non-medical location, commuting, indoor filtration, and lifestyle context.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "city": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "neighborhood": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "postalPrefix": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16,
          "pattern": "^[a-zA-Z0-9\\-\\s]+$"
        },
        "locationPreferences": {
          "type": "object"
        },
        "householdSize": {
          "type": "integer"
        },
        "householdComposition": {
          "type": "array"
        },
        "primaryCommuteMode": {
          "type": "string",
          "enum": ["walking", "cycling", "public_transit", "ev", "carpool", "gas_vehicle"]
        },
        "outdoorActivityPattern": {
          "type": "string",
          "enum": [
            "mostly_indoors",
            "morning_commute",
            "evening_exercise",
            "school_run_family",
            "extended_outdoor"
          ]
        },
        "ventilationContext": {
          "type": "string",
          "enum": [
            "natural_windows",
            "mechanical_hvac",
            "filtered_hvac_merv13",
            "portable_hepa_only"
          ]
        },
        "hasIndoorAirPurifier": {
          "type": "boolean"
        },
        "heatingType": {
          "type": "string",
          "enum": ["electric", "heat_pump", "natural_gas", "solid_fuel", "district"]
        },
        "lifestylePreferences": {
          "type": "object"
        },
        "onboardingCompleted": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "country",
        "city",
        "neighborhood",
        "postalPrefix",
        "locationPreferences",
        "householdSize",
        "householdComposition",
        "primaryCommuteMode",
        "outdoorActivityPattern",
        "ventilationContext",
        "hasIndoorAirPurifier",
        "heatingType",
        "lifestylePreferences",
        "onboardingCompleted",
        "createdAt",
        "updatedAt"
      ]
    },
    "CommunityAdvisory": {
      "title": "CommunityAdvisory",
      "description": "Coordinator-published community air quality guidance without social feeds.",
      "type": "object",
      "properties": {
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "city": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 140
        },
        "summary": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1200
        },
        "severity": {
          "type": "string",
          "enum": ["moderate", "unhealthy_sensitive", "unhealthy", "very_unhealthy", "hazardous"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "archived"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "authorUid",
        "city",
        "title",
        "summary",
        "severity",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Authenticated user account metadata (non-PII)."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Strictly isolated PII document readable only by the owning user or an admin."
    },
    "/households/{householdId}": {
      "schema": { "$ref": "#/entities/HouseholdProfile" },
      "description": "User-owned household location, commuting, indoor air, and lifestyle profile."
    },
    "/communityAdvisories/{advisoryId}": {
      "schema": { "$ref": "#/entities/CommunityAdvisory" },
      "description": "Verified community coordinator advisories readable by verified signed-in users."
    }
  }
}
