{
  "name": "urban-air-quality-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "dev:web": "vite --port=3000 --host=0.0.0.0",
    "dev:api": "tsx apps/api/src/server.ts",
    "start": "NODE_ENV=production tsx server.ts",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build",
    "build:api": "esbuild apps/api/src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=apps/api/dist/server.js",
    "preview": "vite preview --port=3000 --host=0.0.0.0",
    "clean": "rm -rf dist apps/api/dist coverage playwright-report test-results",
    "typecheck": "tsc -p packages/contracts/tsconfig.json --noEmit && tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck && oxlint --config .oxlintrc.json && eslint .",
    "lint:rules": "eslint firestore.rules",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test:unit": "vitest run packages/contracts/tests apps/api/tests/unit apps/web/tests/unit",
    "test:integration": "vitest run apps/api/tests/integration",
    "test:a11y": "vitest run apps/web/tests/unit",
    "test:e2e": "playwright test -c apps/web/playwright.config.ts",
    "test": "npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.14.1",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
